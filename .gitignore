__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
/.pytest-tmp-*/
/.test-tmp-*/
/tmp_test_runs/
.env
.env.*
!.env.example
.venv/
build/
dist/
.idea/
.vscode/
# Local editor configuration
.Rhistory
# generated report output at repo root
/reports/
.tmp/
# runtime DBs are rebuildable indexes; content files + baselines stay tracked
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db
*.pem
*.key
*.p12
*.pfx
.npmrc
.pypirc
# experiment data packs stay local (rebuildable from an operator-provided source directory)
/*.zip
# Generated frontend utilities stay local. Product scripts and frozen fixtures are versioned because
# a clean clone must be able to run the documented gates.
/apps/web/scripts/
# Local scratch/working area - not product
scratchpad/

# Model weights and Hugging Face caches are provisioned from pinned revisions in
# model-revisions.json; never commit multi-GB local snapshots.
/.cache/huggingface/
/.huggingface/
/model-cache/
/models/

# UE content-only plugin: never commit regenerated engine artifacts (content-only plugins don't
# even produce these, but guard defensively). The .uplugin + Content/Python/*.py are the payload.
integrations/unreal/**/Binaries/
integrations/unreal/**/Intermediate/

# Unity UPM package: the payload is text (.cs/.asmdef/package.json/.md) + committed .meta (GUIDs must
# be tracked). Ignore only Unity/dotnet build artifacts from any throwaway authoring/test project —
# never .meta.
integrations/unity/**/[Ll]ibrary/
integrations/unity/**/[Tt]emp/
integrations/unity/**/[Oo]bj/
integrations/unity/**/[Ll]ogs/

# --- Local working notes ----------------------------------------------------
# The complete docs workspace is intentionally outside the public repository.
/docs/
