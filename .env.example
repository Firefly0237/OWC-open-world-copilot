# Copy to .env and fill in ONLY when you wire a real provider.
# The default product/demo path runs fully offline with a deterministic provider — no keys needed.
# Every knob listed here has a real reader in the codebase (dead knobs get deleted, not kept).
OWCOPILOT_LLM_MODE=offline
OWCOPILOT_LLM_PROVIDER=openai_compatible
OWCOPILOT_CHEAP_MODEL=<provider-model-id>
# Project-prefixed variables take precedence over machine-global OPENAI_* variables.
OWCOPILOT_OPENAI_BASE_URL=https://<openai-compatible-provider>
OWCOPILOT_OPENAI_API_KEY=<provider-api-key>
# Native Anthropic is an alternative configuration (the `[live]` extra installs its adapter):
#   OWCOPILOT_LLM_PROVIDER=anthropic
#   OWCOPILOT_CHEAP_MODEL=claude-sonnet-4-5
#   OWCOPILOT_OPENAI_BASE_URL=https://api.anthropic.com
#   OWCOPILOT_OPENAI_API_KEY=<anthropic-api-key>
# The current unified credential reader intentionally does not read ANTHROPIC_API_KEY by itself.
# Legacy-compatible aliases; leave empty when the project-prefixed values above are used.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional resilience fallback provider (llm/resilience.py):
OWCOPILOT_FALLBACK_MODEL=
OWCOPILOT_FALLBACK_BASE_URL=
OWCOPILOT_FALLBACK_API_KEY=

# Set this for any real-mode API deployment; requests must send X-API-Key.
OWCOPILOT_API_KEY=<choose-a-service-api-key>

# --- N1.2 PostgreSQL team profile ---
# Keep `local` for the existing single-machine file/SQLite workflow. `team` exposes only the
# PostgreSQL-backed canonical route; unmigrated routes fail closed.
OWCOPILOT_PROFILE=local
OWCOPILOT_POSTGRES_DB=owcopilot
OWCOPILOT_POSTGRES_PORT=5432
OWCOPILOT_POSTGRES_ADMIN_USER=owcopilot_admin
OWCOPILOT_POSTGRES_ADMIN_PASSWORD=<choose-an-admin-password>
OWCOPILOT_MIGRATION_PASSWORD=<choose-a-migration-role-password>
OWCOPILOT_APP_PASSWORD=<choose-an-app-role-password>
# Use URL-encoded passwords when constructing these URLs outside Compose.
OWCOPILOT_MIGRATION_DATABASE_URL=postgresql+psycopg://owcopilot_migration:<url-encoded-password>@127.0.0.1:5432/owcopilot
OWCOPILOT_TEAM_DATABASE_URL=postgresql+psycopg://owcopilot_app:<url-encoded-password>@127.0.0.1:5432/owcopilot
OWCOPILOT_JWT_SECRET=<choose-a-long-random-team-token-secret>

# --- Service safety / cost guardrails ---
OWCOPILOT_RATE_LIMIT_PER_MIN=60
OWCOPILOT_RATE_LIMIT_BACKEND=memory
OWCOPILOT_REDIS_URL=redis://redis:6379/0
OWCOPILOT_PROVIDER_TIMEOUT_SEC=60

# --- Unreal Engine integration (optional; see integrations/README.md) ---
# Read by the editor menu (init_unreal.py): the exported unreal/ dir and an optional table-map JSON
# ({"Quests": "/Game/.../QuestTable"}). The Remote Control / Remote Execution clients take their
# endpoints as function arguments (src/owcopilot/integrations/unreal_remote.py), not env vars.
OWCOPILOT_UE_EXPORT_DIR=<path-to-export>/unreal
OWCOPILOT_UE_TABLE_MAP=<path-to>/owcopilot_table_map.json
