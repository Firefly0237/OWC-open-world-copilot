# Copy to .env and fill in ONLY when you wire a real provider.
# P0 runs fully offline with the mock provider — no keys needed.
# Every knob listed here has a real reader in the codebase (dead knobs get deleted, not kept).
OPENAI_BASE_URL=https://<openai-compatible-provider>
OPENAI_API_KEY=sk-...
# Optional resilience fallback provider (llm/resilience.py):
OWCOPILOT_FALLBACK_BASE_URL=
OWCOPILOT_FALLBACK_API_KEY=

# Set this for any real-mode API deployment; requests must send X-API-Key.
OWCOPILOT_API_KEY=<choose-a-service-api-key>

# --- Service safety / cost guardrails ---
OWCOPILOT_RATE_LIMIT_PER_MIN=60
OWCOPILOT_RATE_LIMIT_BACKEND=memory
OWCOPILOT_REDIS_URL=redis://redis:6379/0
OWCOPILOT_PROVIDER_TIMEOUT_SEC=30

# --- Unreal Engine integration (optional; see docs/UE_INTEGRATION.md — live run pending) ---
# Read by the editor menu (init_unreal.py): the exported unreal/ dir and an optional table-map JSON
# ({"Quests": "/Game/.../QuestTable"}). The Remote Control / Remote Execution clients take their
# endpoints as function arguments (src/owcopilot/integrations/unreal_remote.py), not env vars.
OWCOPILOT_UE_EXPORT_DIR=<path-to-export>/unreal
OWCOPILOT_UE_TABLE_MAP=<path-to>/owcopilot_table_map.json
