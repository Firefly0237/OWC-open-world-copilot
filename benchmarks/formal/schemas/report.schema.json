{
  "$defs": {
    "EvalProvider": {
      "enum": [
        "fixture",
        "scripted",
        "real_model"
      ],
      "title": "EvalProvider",
      "type": "string"
    },
    "EvalSplit": {
      "enum": [
        "canary",
        "dev",
        "sealed"
      ],
      "title": "EvalSplit",
      "type": "string"
    },
    "EvalStatus": {
      "description": "The only statuses allowed in formal evaluation artifacts.",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "NOT_AVAILABLE",
        "INVALID",
        "BLOCKED_EXTERNAL_DATA"
      ],
      "title": "EvalStatus",
      "type": "string"
    },
    "EvaluationCounts": {
      "additionalProperties": false,
      "properties": {
        "errored_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Errored Cases",
          "type": "integer"
        },
        "executed_cases": {
          "minimum": 0,
          "title": "Executed Cases",
          "type": "integer"
        },
        "failed_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Failed Cases",
          "type": "integer"
        },
        "passed_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Passed Cases",
          "type": "integer"
        },
        "skipped_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Skipped Cases",
          "type": "integer"
        },
        "total_cases": {
          "minimum": 0,
          "title": "Total Cases",
          "type": "integer"
        }
      },
      "required": [
        "total_cases",
        "executed_cases"
      ],
      "title": "EvaluationCounts",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "baseline_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Value"
        },
        "effect_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Size"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sample_size": {
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/MetricScope"
        },
        "success_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Count"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "scope",
        "sample_size",
        "unit"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "MetricScope": {
      "enum": [
        "harness",
        "quality"
      ],
      "title": "MetricScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate report with separate harness validity and quality-evaluation status.",
  "properties": {
    "counts": {
      "$ref": "#/$defs/EvaluationCounts"
    },
    "evaluation_status": {
      "$ref": "#/$defs/EvalStatus"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "harness_status": {
      "$ref": "#/$defs/EvalStatus"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MetricResult"
      },
      "title": "Metrics",
      "type": "array"
    },
    "primary_metric": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Metric"
    },
    "provider": {
      "$ref": "#/$defs/EvalProvider"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "formal-eval/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skipped": {
      "default": false,
      "title": "Skipped",
      "type": "boolean"
    },
    "split": {
      "$ref": "#/$defs/EvalSplit"
    },
    "status_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Status Reasons",
      "type": "array"
    },
    "suite_id": {
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    },
    "suite_version": {
      "minLength": 1,
      "title": "Suite Version",
      "type": "string"
    },
    "trace_sha256s": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Trace Sha256S",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "suite_id",
    "suite_version",
    "run_id",
    "split",
    "provider",
    "generated_at",
    "harness_status",
    "evaluation_status",
    "counts"
  ],
  "title": "FormalEvalReport",
  "type": "object"
}
