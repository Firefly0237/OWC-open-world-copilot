# Keep the build context small AND keep secrets out of the image.
# .env holds real provider keys — it must NEVER enter a layer; inject keys at runtime.
.env
.env.*
!.env.example

# Local virtualenv / caches / build artifacts
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.tmp/
reports/
*.sqlite
*.sqlite-shm
*.sqlite-wal
# Host model/tokenizer caches never enter the context; image builds provision the pinned tokenizer
# into a dedicated cache and verify it offline before the runtime stage.
.cache/
.huggingface/
model-cache/
models/
# The frontend is built fresh inside the image's node stage; never ship host artifacts.
apps/web/node_modules/
apps/web/dist/

# Editors / VCS / local scratch
.idea/
.vscode/
.git/
.gitignore
.Rhistory

# Docs and tests aren't needed in the runtime image (tests run in CI, not in the container).
tests/
docs/
*.md
!README.md
