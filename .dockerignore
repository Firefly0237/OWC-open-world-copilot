# Credentials and user data never enter the build context.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.npmrc
.pypirc
var/
content/
*.sqlite*
*.db*

# Machine-local environments, caches and generated files.
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.tmp/
reports/
.cache/
.huggingface/
model-cache/
models/
apps/web/node_modules/
apps/web/dist/

# Repository tools and documentation do not belong in the runtime image.
.git/
.github/
.claude/
**/.owcopilot/
.idea/
.vscode/
.Rhistory
tests/
docs/
*.md
!README.md
